################################################################################
# Machine-specific overrides
################################################################################

# This file is an example for settings that should apply only to one machine.
#
# To enable local overrides, copy this file to:
#
#   90-local.conf
#
# The resulting file is intentionally ignored by Git.
#
# Because this file is loaded after the shared configuration, values declared
# here override the corresponding values from the previous configuration files.

################################################################################
# Display-specific overrides
################################################################################

# Example: use a larger font on a high-resolution or external display.
# font-size = 16

# Example: adjust the initial window size for a specific screen.
# window-width = 140
# window-height = 42

################################################################################
# Rendering overrides
################################################################################

# Example: increase the minimum contrast on a display where low-intensity
# colors remain difficult to read.
# minimum-contrast = 5.0

# Example: enable limited transparency on a machine where readability has
# already been verified.
# background-opacity = 0.96

################################################################################
# Keyboard overrides
################################################################################

# Example: use only the left Option key as Alt while preserving the right
# Option key for normal macOS character input.
# macos-option-as-alt = left

################################################################################
# Shell overrides
################################################################################

# Example: launch a different shell only on this machine.
# command = /opt/homebrew/bin/fish

################################################################################
# Debugging
################################################################################

# Keep local experiments in this file instead of modifying the shared
# configuration. Remove or comment out an override once it is no longer needed.
