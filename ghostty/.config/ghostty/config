################################################################################
# Ghostty
################################################################################

# Main entry point for the Ghostty configuration.
#
# The configuration is split into focused files to keep each section readable,
# testable and indipendently maintainable.
#
# Relative paths are resolved from the directory containing this file.
# Included files are loaded in the order declared below.

config-file = conf.d/10-font.conf
config-file = conf.d/20-theme.conf
config-file = conf.d/30-window.conf
config-file = conf.d/40-macos.conf
config-file = conf.d/50-keybindings.conf
config-file = conf.d/60-shell.conf

# Optional machine-specific overrides.
#
# Copy 90-local.conf.example to 90-local.conf when a host requires settings
# that should not be committed to the repository.
#
# The leading "?" makes the file optional.

config-file = ?conf.d/90-local.conf
