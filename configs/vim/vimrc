" ==============================================================================
" Vim configuration
" ==============================================================================

" Loads the modern defaults distributed with Vim.
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim

" Directory containing this vimrc.
let s:config_dir = expand('<sfile>:p:h')

" Loads all modules in config/ in alphabetical order.
for s:config_file in sort(glob(s:config_dir . '/config/*.vim', 0, 1))
	execute 'source' fnameescape(s:config_file)
endfor

unlet! s:config_file
unlet! s:config_dir
